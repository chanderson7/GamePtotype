## Keys that share another's picture.
const SAME := {"journal": "book", "rings": "bond", "resume": "play", "battle": "fight"}

static var _made := {}


## Which key each plain icon texture is (see key_of), and the icons set on an iron boss.
static var _keys := {}
static var _bossed := {}


## The key of a pixel icon's texture, or "" if `tex` isn't one (a line drawing, a boss).
static func key_of(tex: Texture2D) -> String:
	return String(_keys.get(tex, ""))


static func is_boss(tex: Texture2D) -> bool:
	return _bossed.values().has(tex)


## The icon in its own colours on a small dark iron boss, for a brass plate: on brass a
## brass icon would be lost and a tinted one goes flat, so it sits on iron, as a fitting
## riveted to the button.
static func boss(key: String) -> Texture2D:
	key = String(SAME.get(key, key))
	if _bossed.has(key):
		return _bossed[key]
	var plain := texture(key)
	if plain == null:
		return null
	var n := SIZE + 6
	var img := Image.create_empty(n, n, false, Image.FORMAT_RGBA8)
	var c := Vector2(n * 0.5, n * 0.5)
	for y in n:
		for x in n:
			var d := Vector2(x + 0.5, y + 0.5).distance_to(c)
			if d <= 8.6:
				# An iron rim, lit from the upper left, round a darker face.
				var rim := d > 7.4
				var lit := (x + y) < n - 2
				img.set_pixel(x, y, (Color("78818e") if lit else Color("3d434d")) if rim else Color("22262d"))
	var small := plain.get_image()
	small.resize(SIZE + 2, SIZE + 2, Image.INTERPOLATE_NEAREST)
	for y in SIZE + 2:
		for x in SIZE + 2:
			var px := small.get_pixel(x, y)
			if px.a > 0.0:
				img.set_pixel(x + 2, y + 2, px)
	img.resize(n * SCALE, n * SCALE, Image.INTERPOLATE_NEAREST)
	var tex := ImageTexture.create_from_image(img)
	_bossed[key] = tex
	return tex


static func has(key: String) -> bool:
	return ICONS.has(String(SAME.get(key, key)))


## The icon for `key`, or null if there is no pixel icon for it.
static func texture(key: String) -> Texture2D:
	key = String(SAME.get(key, key))
	if _made.has(key):
		return _made[key]
	if not ICONS.has(key):
		return null
	var spec: Array = ICONS[key]
	var tones: Array = MATERIALS[String(spec[0])]
	var second: Color = spec[2] if spec[2] != null else tones[3]
	var colours := {"#": tones[0], "+": tones[1], "-": tones[2], "o": second,
		"g": Color("d6dce4") if key == "bow" else Color("d9a944"), "r": Color("a8352a")}
	var n := SIZE + 2
	var img := Image.create_empty(n, n, false, Image.FORMAT_RGBA8)
	var rows: Array = spec[1]
	for y in SIZE:
		var row := String(rows[y])
		for x in SIZE:
			if row[x] != ".":
				img.set_pixel(x + 1, y + 1, colours[row[x]])
	# The outline goes round the outside only: a gap inside a shape (between a bow's
	# string and its limb) stays open. Outside is what can be reached from the corner.
	var outside := {}
	var todo: Array[Vector2i] = [Vector2i(0, 0)]
	while not todo.is_empty():
		var at: Vector2i = todo.pop_back()
		if outside.has(at) or at.x < 0 or at.y < 0 or at.x >= n or at.y >= n or img.get_pixelv(at).a > 0.0:
			continue
		outside[at] = true
		for step in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			todo.append(at + step)
	var edged := img.duplicate() as Image
	for at in outside:
		for step in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			var to: Vector2i = at + step
			if to.x >= 0 and to.y >= 0 and to.x < n and to.y < n and img.get_pixelv(to).a > 0.0:
				edged.set_pixelv(at, OUTLINE)
				break
	edged.resize(n * SCALE, n * SCALE, Image.INTERPOLATE_NEAREST)
	var tex := ImageTexture.create_from_image(edged)
	_made[key] = tex
	_keys[tex] = key
	return tex

